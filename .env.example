# Copy to .env and fill in. .env is gitignored; never commit real tokens.

# --- Database -------------------------------------------------------------
# SQLite for local dev/demo. Relative paths resolve from prisma/, so this
# creates prisma/dev.db. For Postgres (docker-compose.yml), switch the
# datasource provider in prisma/schema.prisma and use e.g.
# postgresql://team_sprint:team_sprint@localhost:5432/team_sprint
DATABASE_URL="file:./dev.db"

# --- Admin API (npm run api:dev) ------------------------------------------
# Shared key clients send in the x-admin-api-key header.
ADMIN_API_KEY="change-me"
API_PORT=3001

# --- Slack app (npm run slack:dev) ----------------------------------------
# Only needed to run the real Slack app; see "Setting up the real Slack app"
# in the README.
SLACK_BOT_TOKEN="xoxb-..."
SLACK_SIGNING_SECRET=""
SLACK_APP_TOKEN="xapp-..."
